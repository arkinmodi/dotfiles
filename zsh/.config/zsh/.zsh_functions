#!/usr/bin/env zsh
# shellcheck shell=bash

# Needs to be a shell function for `cd` to persist
function git-worktree-switch() {
if [[ $# -eq 1 ]]; then
    dest=$1
else
    dest=$(
    git worktree list \
        | fzf \
        | sed -E -e 's/\s+(.* \[.*\]|\(bare\))$//'
    )
fi
cd "$dest" || return
}

# Prints all 256 colours
function colours() {
    for c in {0..255}; do
        print -Pn "%K{$c}  %k%F{$c}$(printf "%03d" $c) %f"
        (( (c+1)%8 == 0 )) && print
    done
}

function copy-command() {
    echo -n "$BUFFER" | pbcopy
    zle -M "Copied to clipboard"
}

zle -N copy-command
bindkey '^xx' copy-command
bindkey '^x^x' copy-command
